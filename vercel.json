{
  "buildCommand": "npm install && npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "installCommand": "npm install",
  "functions": {
    "api/chat.js": {
      "maxDuration": 60
    },
    "api/sync.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/review", "destination": "/api/review" }
  ],
  "crons": [
    {
      "path": "/api/sync",
      "schedule": "0 15 * * *"
    }
  ]
}
