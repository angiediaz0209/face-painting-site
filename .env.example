# ─────────────────────────────────────────────────────────────
# Environment variables for Face Painting California
#
# HOW TO USE
#   • Local dev:  copy this file to `.env.local` and fill in real values.
#                 `.env.local` is gitignored and must NEVER be committed.
#   • Production: add these same keys in the Vercel dashboard under
#                 Project → Settings → Environment Variables
#                 (do NOT put real values in this file).
# ─────────────────────────────────────────────────────────────

# Anthropic API key for the "Sky" chat assistant (api/chat.js).
# Get one at https://console.anthropic.com/ — starts with "sk-ant-".
ANTHROPIC_API_KEY=

# Google OAuth app credentials (Calendar + Sheets integration).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Google Calendar the bookings are written to.
GOOGLE_CALENDAR_ID=

# Google Sheet used as the booking tracker.
GOOGLE_SHEET_ID=

# Email address that receives new-booking notifications.
ADMIN_NOTIFICATION_EMAIL=

# Sky's private system prompt (pricing + business rules).
# PRODUCTION: paste the full contents of SKY_INSTRUCTIONS.md into this variable
#   in the Vercel dashboard. LOCAL DEV: leave blank — it falls back to the
#   gitignored SKY_INSTRUCTIONS.md file on disk.
SKY_INSTRUCTIONS=

# Shared secret for the Vercel Cron sync and for signing the one-click
# confirm / decline / reschedule / status links. Any long random string.
CRON_SECRET=

# Public base URL of the deployed site, used to build the emailed links.
# e.g. https://facepaintingcalifornia.com
APP_BASE_URL=

# Initial password for the private owner dashboard at /api/owner (bookings
# list + Confirm / Cancel / Reschedule). Pick a strong value; anyone with it
# can see customer details. Leave blank to disable the dashboard entirely.
# Once the owner changes their password from the dashboard (More → Change
# password), the new one is stored hashed in the Settings sheet and this value
# stops working. To recover from a forgotten password, delete the
# `owner_password_hash` row from the sheet's Settings tab.
OWNER_DASHBOARD_PASSWORD=

# Google Analytics 4 Measurement ID (looks like G-XXXXXXXXXX). Optional: when
# unset, no analytics script is loaded. Set it in Vercel for production only so
# local dev and previews don't count as visits.
VITE_GA_MEASUREMENT_ID=
